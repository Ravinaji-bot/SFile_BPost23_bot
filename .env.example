# Required
BOT_TOKEN=123456:your_bot_token
API_ID=123456
API_HASH=your_api_hash
DATABASE_URI=mongodb+srv://username:db-password@cluster.mongodb.net/
LOG_CHANNEL=-1001234567890
ADMINS=123456789
OWNER_ID=123456789

# Recommended
CHANNELS=-1001234567890
BIN_CHANNEL=-1001234567890
DATABASE_NAME=Cluster0
COLLECTION_NAME=dreamcinezone_files

# Web and streaming
PORT=8080
FQDN=your-app-name.onrender.com
HAS_SSL=True
NO_PORT=True
STREAM_MODE=True
PREMIUM_STREAM_MODE=False

# Force subscription
AUTH_CHANNELS=-1001234567890
AUTH_REQ_CHANNELS=-1001234567890
REQST_CHANNEL_ID=-1001234567890
SUPPORT_CHAT_ID=-1001234567890
SUPPORT_CHAT=https://t.me/your_support_group

# PostCardDaily = private channel for all post cards (bot must be admin). Empty = cards go to MOVIE_UPDATE_CHANNEL
POSTCARD_CHANNEL=

# 2nd (helper) bot: the "Click here" links of every post card open THIS bot instead of the main bot.
# Make it admin in BIN_CHANNEL (and in the force-sub channels). Empty = off, cards use the main bot.
POST_BOT_TOKEN=

# Optional features
IS_VERIFY=False
MAINTENANCE=False
TMDB_API_KEY=
SHORTENER_WEBSITE=
SHORTENER_API=
TMDB_BEARER_TOKEN=
IMGBB_API_KEY=
FILE_DELETE_TIME=50
PM_POST_FIRST=True
POST_ARCHIVE_BEFORE=30
RESULT_ARCHIVE_CHANNEL=

# /start auto-delete (seconds)
START_CMD_DELETE_TIME=3
START_HOME_DELETE_TIME=300

# --- /autopost (optional: the /autopost commands can set these too) ---
AUTOPOST_MOVIE_CHANNEL=
AUTOPOST_SERIES_CHANNEL=
AUTOPOST_STICKER=
AUTOPOST_DELAY=2

# Group protection (plugins/antispam.py)
# master switch
ANTISPAM=True
# state of a group that never used /antispam on|off
ANTISPAM_DEFAULT_ON=True
# ban every bot that somebody adds to a group
ANTISPAM_BAN_BOTS=True
# always allowed links / @names / domains, separated by space or comma, e.g. "@mychannel mysite.com"
ANTISPAM_ALLOWED=

# Videos smaller than this many MB are never indexed / shown / posted (samples). 0 = off
MIN_FILE_SIZE_MB=30

# false = no landscape backdrop on TMDB -> use the video's own thumbnail, not the portrait poster. true = old behaviour
ALLOW_PORTRAIT_POSTER=False

# true = channel posts (live auto-post, /bulkpost) show the poster in the box below the text. false = photo above the text
LINK_PREVIEW=True

# RAM guard (memory_guard.py): cleans memory every RAM_CLEAN_INTERVAL seconds and restarts the bot
# before the host kills it (above 90% of RAM_LIMIT_MB, only if it stays there)
RAM_LIMIT_MB=512
RAM_CLEAN_INTERVAL=120
RAM_AUTO_RESTART=True

# Premium purchase / redeem log channel (falls back to LOG_CHANNEL when empty)
PREMIUM_LOGS=
# Verification log channel used by groups that did not run /set_log_channel (falls back to LOG_CHANNEL)
LOG_VR_CHANNEL=
# True = a group admin / owner may add bots to his own group (antispam still bans every other added bot)
ANTISPAM_ADMINS_CAN_ADD_BOTS=True

# Auto clean: everything the bot sends in a PM or a group (replies, filters, errors) is deleted after this many seconds
# (360 = 6 minutes, 0 = off). The other delete times (DELETE_TIME, FILE_DELETE_TIME ...) are not changed.
AUTO_CLEAN_TIME=360
# True = the messages users type in the bot's PM are deleted after the same time (PM only, groups are not touched)
CLEAN_USER_PM_MESSAGES=True
# Broadcasts stay this many seconds (86400 = 24 h) until the owner changes it with /bcdelete (0 = never delete)
BROADCAST_DELETE_TIME=86400

# Chat guard: the bot works ONLY in groups / channels the owner approved (owner adds the bot = approved,
# otherwise the owner gets an Approve / Leave message). Private chats are never touched.
CHAT_GUARD=True
# True = the bot also leaves an unapproved chat at once. False = it stays silent and asks the owner
CHAT_GUARD_AUTO_LEAVE=False
# Extra chat ids / @usernames that are always allowed (space separated). Chats in CHANNELS, LOG_CHANNEL,
# SUPPORT_CHAT_ID ... and the channels set with /autopost, /autoforward, /ccopy ... are allowed automatically.
ALLOWED_CHATS=

# Brand in every caption / post heading: "🐉 Jailer (2023) 1080p WEB-DL [Hindi ORG - Tamil] 𝑫𝒓𝒂𝒈𝒐𝒏𝑭𝒊𝒓𝒆𝑾𝒐𝒓𝒍𝒅.mkv"
# Empty = off. If your /setfilecaption text already has the tag (e.g. "{file_name} ➥ 𝑫𝒓𝒂𝒈𝒐𝒏𝑭𝒊𝒓𝒆𝑾𝒐𝒓𝒍𝒅") the bot does not add it twice.
NAME_BRAND_EMOJI=🐉
NAME_BRAND_TAG=𝑫𝒓𝒂𝒈𝒐𝒏𝑭𝒊𝒓𝒆𝑾𝒐𝒓𝒍𝒅
